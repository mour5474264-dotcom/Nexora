# Service URLs
NEXORA_AGENT_GATEWAY_URL=http://127.0.0.1:9000
OPEN_WEBUI_URL=http://127.0.0.1:8080
LITELLM_URL=http://127.0.0.1:4000

# Storage
NEXORA_DATA_DIR=./data
NEXORA_ARTIFACT_DIR=./artifacts

# Development only. Production secrets must use the OS credential store or a secret manager.
NEXORA_LOG_LEVEL=info
NEXORA_ALLOW_LOCAL_WORKERS=true

